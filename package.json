{
  "name": "feature-flag-management",
  "version": "0.33.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:seed": "tsx prisma/seed.ts",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "next typegen && tsgo --noEmit",
    "knip": "knip",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:deploy": "prisma migrate deploy",
    "db:validate": "prisma validate",
    "db:check-migrations": "prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --exit-code",
    "postinstall": "prisma generate",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run knip",
    "ci": "npm run check && npm run db:validate && npm run db:check-migrations && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@sentry/nextjs": "^11.12.0",
    "@vercel/otel": "^2.3.0",
    "better-auth": "^1.7.25",
    "dotenv": "^18.0.10",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.73.0",
    "next": "^16.4.6",
    "pino": "^10.4.0",
    "posthog-js": "^1.450.0",
    "posthog-node": "^5.74.0",
    "prom-client": "^15.1.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "knip": "^6.45.1",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "pino-pretty": "^13.2.0",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-plugin-css-modules": "^5.3.0",
    "vitest": "^5.1.0",
    "wait-on": "^9.5.1"
  }
}
