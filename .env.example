
# Database (required)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/feature_flag_db

# Auth (required)
BETTER_AUTH_SECRET=replace-with-a-random-string-of-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000

# Redis pub/sub, needed with 2 or more servers (optional, leave empty to run without it)
REDIS_URL=redis://localhost:6379

# Sentry error tracking (optional, leave empty to run without it)
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# PostHog product analytics (optional, leave empty to run without it)
NEXT_PUBLIC_POSTHOG_KEY=phc_exampleProjectApiKey
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Tracing with OpenTelemetry to Tempo (optional, leave empty to run without it)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Logs
LOG_LEVEL=info

# Protects /api/metrics (optional, leave empty to leave it open)
METRICS_TOKEN=replace-with-a-random-string

# Where uploaded files are stored until S3 is set up
UPLOADS_DIR=.uploads

# This app reading its own flags through the SDK (optional, leave empty to run without it)
NEXT_PUBLIC_FLAGS_SDK_KEY=sdk-replace-with-the-development-sdk-key
NEXT_PUBLIC_FLAGS_BASE_URL=http://localhost:3000
