
# Database (required)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/feature_flag_db

# Auth (required)
BETTER_AUTH_SECRET=replace-with-a-random-string-of-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000

# Redis for flag updates: tells every server when a flag changed (needed with 2 or more servers)
FLAGS_REDIS_URL=redis://localhost:6379

# Redis for server status: every server posts its numbers here for the Status page
STATUS_REDIS_URL=redis://localhost:6380

# AWS. Locally the keys can be anything; on AWS leave them out and the ECS task role is used
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# File storage (S3). Locally S3_ENDPOINT points at SeaweedFS; on AWS leave it empty
S3_BUCKET=feature-flags-uploads
S3_ENDPOINT=http://localhost:8333

# Queue for icon jobs (SQS). Locally SQS_ENDPOINT points at ElasticMQ; on AWS leave it empty
SQS_ENDPOINT=http://localhost:9324
ICON_QUEUE_URL=http://localhost:9324/000000000000/icons

# Sentry error tracking (optional, leave empty to run without it)
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# PostHog product analytics (optional, leave empty to run without it)
NEXT_PUBLIC_POSTHOG_KEY=phc_exampleProjectApiKey
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Tracing with OpenTelemetry to Tempo (optional, leave empty to run without it)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Logs
LOG_LEVEL=info

# Protects /api/metrics (optional, leave empty to leave it open)
METRICS_TOKEN=replace-with-a-random-string

# This app reading its own flags through the SDK (optional, leave empty to run without it)
NEXT_PUBLIC_FLAGS_ENV_SDK_KEY=sdk-replace-with-the-development-sdk-key
NEXT_PUBLIC_FLAGS_BASE_URL=http://localhost:3000
