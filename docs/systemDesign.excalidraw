      "boundElements": [],
      "updated": 1794959158161,
      "link": null,
      "locked": false,
      "text": "Rules are checked top to bottom; the first match wins. To pin specific users, add a rule on key at the top.\nRollout = a slider + % per variation, must total 100%. Save asks for a comment → saved to the company log.",
      "originalText": "Rules are checked top to bottom; the first match wins. To pin specific users, add a rule on key at the top.\nRollout = a slider + % per variation, must total 100%. Save asks for a comment → saved to the company log.",
