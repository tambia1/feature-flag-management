      "seed": 1310491452,
      "version": 6,
      "versionNonce": 165449582,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794958352873,
      "link": null,
      "locked": false,
      "text": "Flag change flow: editor saves → Postgres → publish \"flag changed\" (Redis pub/sub)\n→ every app server clears its in-memory flag cache → pushes \"changed\" to open SDK streams → apps fetch new values\nContexts: each SDK evaluate returns values (+ reason per flag) and saves the latest per context to Postgres (contexts)\nStatus: every app server writes its numbers to Redis every 9 s → the Status page shows all servers",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Flag change flow: editor saves → Postgres → publish \"flag changed\" (Redis pub/sub)\n→ every app server clears its in-memory flag cache → pushes \"changed\" to open SDK streams → apps fetch new values\nContexts: each SDK evaluate returns values (+ reason per flag) and saves the latest per context to Postgres (contexts)\nStatus: every app server writes its numbers to Redis every 9 s → the Status page shows all servers",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": 1794751046592,
      "labelPosition": null,
      "baseFontSize": null,
      "startBinding": null,
      "endBinding": null
    },
