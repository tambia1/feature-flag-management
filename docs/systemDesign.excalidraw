      "boundElements": [],
      "updated": 1794959155028,
      "link": null,
      "locked": false,
      "text": "Rollout = a slider + % per variation, must total 100% (Split evenly). Rules can serve a rollout too.\nSave asks for a comment → saved to the company log. Viewers can't edit.",
      "originalText": "Rollout = a slider + % per variation, must total 100% (Split evenly). Rules can serve a rollout too.\nSave asks for a comment → saved to the company log. Viewers can't edit.",
      "fontSize": 14,
      "fontFamily": 5,
