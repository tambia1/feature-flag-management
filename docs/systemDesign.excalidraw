    {
      "id": "BBZ7IMpBqWi6er5r5E4Pk",
      "type": "text",
      "x": -1290,
      "y": 4720,
      "width": 1168.2,
      "height": 90,
      "angle": 0,
      "strokeColor": "#757575",
      "backgroundColor": "transparent",
