    {
      "id": "YoSWQ8Oo2h8lcQsmKG3CK",
      "type": "text",
      "x": -7510,
      "y": 12100,
      "width": 1168.2,
      "height": 90,
      "angle": 0,
      "strokeColor": "#757575",
